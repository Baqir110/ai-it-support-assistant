# Copy to .env and fill in what you need. Every setting has a safe offline
# default - the app runs with none of these set.

# --- LLM (optional) --------------------------------------------------------
# Leave LLM_PROVIDER=none to use the deterministic rule-based generator.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Embeddings (optional) -------------------------------------------------
# "hashing" = offline, no network/model download required.
# "openai"  = higher-quality semantic embeddings, requires OPENAI_API_KEY.
EMBEDDING_BACKEND=hashing

# --- Persistence (optional) -------------------------------------------------
# If unset, request logging is skipped entirely.
DATABASE_URL=postgresql+psycopg2://it_assistant:it_assistant@localhost:5432/it_assistant
